# Normalize every text file to LF in the repository, on every platform. The
# committed artifacts (artifacts/comparison.json, artifacts/kraken_replay.json)
# are regenerated by the pipeline and diffed byte-for-byte, so their line endings
# have to be a property of the repository rather than of whichever core.autocrlf
# the contributor happens to have set. The writers pin newline="\n" as well; this
# file is the second half of that guarantee.
* text eol=lf

# Binary assets: never touch the bytes, never try to diff them as text.
*.png binary
*.gz binary
*.parquet binary
